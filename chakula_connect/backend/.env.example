# Chakula Connect Environment Variables

# Security Warning: Keep this file out of version control and do not share the secret key!
# Copy this file to `.env` in the same directory and update the values.

# Django Settings
DEBUG=True
SECRET_KEY=your-super-secret-key-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourfrontend.com

# Database URL Structure (uncomment and use when migrating to PostgreSQL)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=chakula_db
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432

# Africas Talking API Credentials
AT_USERNAME=your_at_username
AT_API_KEY=your_at_api_key

# MPESA Daraja API Credentials
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_PASSKEY=your_mpesa_passkey
MPESA_SHORTCODE=your_mpesa_shortcode
